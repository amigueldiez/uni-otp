{
  "manifest_version": 3,
  "name": "Uni-OTP",
  "version": "1.0.0",
  "description": "Genera y rellena los códigos de verificación multifactor.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://sso.unileon.es/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://sso.unileon.es/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Uni-OTP",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
